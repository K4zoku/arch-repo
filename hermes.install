do_setcap() {
    setcap cap_sys_admin+p /usr/bin/hermes
}

do_udev_reload() {
    udevadm control --reload-rules
    udevadm trigger --property-match=DEVNAME=/dev/uinput
    udevadm trigger --property-match=DEVNAME=/dev/uhid
    modprobe uinput || true
    modprobe uhid || true
}

fix_asset_permissions() {
    chown -R root:root /usr/share/hermes
    find /usr/share/hermes -type d -exec chmod 755 {} +
    find /usr/share/hermes -type f -exec chmod 644 {} +
}

post_install() {
    do_setcap
    do_udev_reload
    fix_asset_permissions
}

post_upgrade() {
    do_setcap
    do_udev_reload
    fix_asset_permissions
}
